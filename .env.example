DATABASE_URL=postgresql+psycopg://smartbill_user:change-me@localhost:5432/smartbill
SMARTBILL_SECRET_KEY=replace-with-a-long-random-secret
SMARTBILL_SECURE_COOKIES=false
SHARE_LINK_HOURS=24
# Public HTTPS URL scanned from invoice QR codes, for example https://billing.example.com
SMARTBILL_PUBLIC_URL=
PORT=5000
FLASK_DEBUG=false
RATELIMIT_STORAGE_URI=memory://
SMARTBILL_LOG_LEVEL=INFO
SMARTBILL_AUTO_CREATE_SCHEMA=false
